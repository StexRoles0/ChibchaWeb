# Copia este archivo a .env si quieres cambiar algo. El compose funciona sin .env.

# --- PostgreSQL (servicio db) ---
POSTGRES_DB=chibchaweb
POSTGRES_USER=chibcha
POSTGRES_PASSWORD=chibcha123

# --- Django ---
# Con DJANGO_DEBUG=False el arranque falla si DJANGO_SECRET_KEY falta o es la de desarrollo, si CLAVE_CIFRADO es la
# de desarrollo o si SIMULAR_EXTERNOS=true (S-1, S-2). Sin DEBUG las cookies de sesión y CSRF solo viajan por HTTPS (S-4).
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Local: puerto 5433 del host. Dentro de docker el compose usa db:5432.
DATABASE_URL=postgres://chibcha:chibcha123@localhost:5433/chibchaweb

# --- Cifrado y respaldo (RT04) ---
# 32 bytes en base64. Genera una con: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CLAVE_CIFRADO=ZGV2LWNsYXZlLWNpZnJhZG8tMzItYnl0ZXMtMDAwMDA=
ALGORITMO_CIFRADO=AES
RUTA_RESPALDO=/app/respaldo/respaldo.log

# --- Integraciones externas ---
# Solo con DJANGO_DEBUG=True; en producción va en false y exige OIDC_CLIENT_SECRET y OIDC_REDIRECT_URI.
SIMULAR_EXTERNOS=true
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OIDC_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# Debe coincidir con el URI de redirección registrado en el proveedor (ruta de Angular).
OIDC_REDIRECT_URI=http://localhost:4200/auth/callback
URL_VALIDADOR_TARJETA=
URL_PROCESADOR_PAGOS=
CODIGO_COMERCIO=CHIBCHAWEB
URL_REGISTRADOR_DOMINIOS=
# Carpeta o URL con los CSV del sistema legado (clientes.csv, hosting.csv, pagos.csv)
ORIGEN_DATOS_LEGADO=/app/datos_legados
